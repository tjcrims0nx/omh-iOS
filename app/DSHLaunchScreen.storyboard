<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="22155" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="LS-vc">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="22131"/>
        <capability name="Named colors" minToolsVersion="9.0"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="System colors in document resources" minToolsVersion="11.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="LS-scene">
            <objects>
                <viewController id="LS-vc" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="LS-view">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView userInteractionEnabled="NO" contentMode="scaleAspectFit" image="OpenMindLogo" translatesAutoresizingMaskIntoConstraints="NO" id="LS-label">
                                <rect key="frame" x="24" y="382" width="345" height="88"/>
                                <constraints><constraint firstAttribute="height" constant="88" id="LS-height"/></constraints>
                            </imageView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="LS-safe"/>
                        <color key="backgroundColor" name="DSHBackground"/>
                        <constraints>
                            <constraint firstItem="LS-label" firstAttribute="centerX" secondItem="LS-view" secondAttribute="centerX" id="LS-c1"/>
                            <constraint firstItem="LS-label" firstAttribute="centerY" secondItem="LS-view" secondAttribute="centerY" id="LS-c2"/>
                            <constraint firstItem="LS-label" firstAttribute="leading" secondItem="LS-safe" secondAttribute="leading" constant="24" id="LS-c3"/>
                            <constraint firstItem="LS-safe" firstAttribute="trailing" secondItem="LS-label" secondAttribute="trailing" constant="24" id="LS-c4"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="LS-fr" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="0" y="0"/>
        </scene>
    </scenes>
    <resources>
        <image name="OpenMindLogo" width="900" height="300"/>
        <namedColor name="DSHBackground">
            <color red="0.0196078431" green="0.0313725490" blue="0.0862745098" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
        <systemColor name="labelColor">
