#!/bin/sh
# Linux Bubblewrap must actually pass a namespace-mount probe inside iSH.
# Never claim sandboxing merely because bwrap is installed.
set -eu
export HOME=/root
export OMH_WORKSPACE="${OMH_WORKSPACE:-${OPENCODE_WORKSPACE:-/root/workspace}}"
exec /usr/bin/node /usr/local/share/omh-runtime/scripts/omh-runtime.mjs doctor
